#compdef gtroff
# Generated by gtroff completion; do not edit.
local -a candidates
if (( CURRENT == 2 )); then
  candidates=(validate ast sources render convert serve version man completion help)
  compadd -- $candidates
else
  case $words[2] in
    validate) candidates=(--format --help --package --strict) ;;
    ast) candidates=(--format --help --package --select --strict) ;;
    sources) candidates=(--format --help --max-bytes --max-depth --max-files --max-nodes --no-includes --package --root --strict) ;;
    render) candidates=(--assets --dpi --font --font-bold --font-italic --font-mono --font-regular --font-size --format --fragment --help --line-height --margin --max-height --max-pixels --max-width --no-anchors --node --page-height --quality --section --single --strict --theme --title --width -o) ;;
    convert) candidates=(--assets --fragment --from --help --strict --to -i -o) ;;
    serve) candidates=(--allow-remote --assets --help --listen --max-file-bytes --max-pages --max-total-bytes --root --system-search --theme) ;;
    version) candidates=(--help) ;;
    man) candidates=(--help) ;;
    completion) candidates=(--help) ;;
    help) candidates=(--help) ;;
  esac
  if [[ $PREFIX == -* ]]; then compadd -- $candidates; else _files; fi
fi
