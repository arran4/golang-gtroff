{{.SubCommandExtendedHelp}}
{{- else}}
Usage: {{.FullUsageString}}
{{- if .SubCommandDescription}}

{{.SubCommandDescription}}
{{- end}}
{{- if or .SubCommands .SubCommandFunctionName}}

Subcommands:
{{- range .SubCommands}}
{{- if .SubCommandDescription}}
    {{.SubCommandName | printf "%-10s"}} {{.SubCommandDescription}}
{{- else}}
    {{.SubCommandName}}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
