Broken custom file readers are skipped with notices, closed exactly once and do
not prevent a later valid page from entering the immutable HTTP snapshot.

-- scenario.json --
{"ReadFaults":{"a.1":"empty","b.1":"negative","c.1.gz":"oversized"},"Requests":[{"Target":"/page/1/a","Status":404,"Contains":["page not found"]},{"Target":"/page/1/z","Status":200,"Contains":["still visible"],"Absent":["broken payload"]}]}
-- tree/a.1 --
broken payload
-- tree/b.1 --
broken payload
-- tree/c.1.gz --
broken payload
-- tree/z.1 --
.TH Z 1
.SH NAME
z \- still visible
-- expected/entries.json --
[
  {
    "Name": "z",
    "Section": "1",
    "Description": "still visible",
    "Root": "fixture",
    "Path": "z.1",
    "URL": "/page/1/z?root=fixture",
    "Diagnostics": 0
  }
]
