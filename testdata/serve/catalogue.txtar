{"requests":[{"target":"/","status":200,"contains":["ssl(3ssl)","tool(1)","tool(3)","useful command"]},{"target":"/search?q=quasar","status":200,"contains":["tool(1)"],"absent":["tool(3)"]},{"target":"/search?q=ABSENT","status":200,"contains":["No matching pages."]}]}
