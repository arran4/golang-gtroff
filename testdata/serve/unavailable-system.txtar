Unavailable optional man-db search leaves built-in name/description/text results usable.
-- tree/man1/tool.1 --
.TH TOOL 1
.SH NAME
tool \- useful utility
-- scenario.json --
{"provider":"unavailable","requests":[{"target":"/search?q=useful","status":200,"contains":["tool(1)","System search unavailable; built-in results shown."]}]}
