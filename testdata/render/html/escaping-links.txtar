test: source HTML is escaped and script/file/relative links cannot become active
-- options.json --
{"Assets":"omit-fonts","Title":"</title><script>bad</script>"}
-- input.1 --
.SH DESCRIPTION
<script>alert(1)</script> & <img src=x onerror=bad>
.UR javascript:alert(1)
unsafe script target
.UE
.UR file:///etc/passwd
unsafe file target
.UE
.UR https://example.invalid/path?a=1&b=2
safe link
.UE
.MT person@example.invalid
email
.ME .
-- expected.html --
