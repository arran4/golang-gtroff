test: Unicode content and inherited indent render in a dark fragment
-- options.json --
{"Fragment":true,"Theme":"dark","Section":"雪 Café","NoAnchors":true}
-- input.1 --
.TH TOOL 1
.SH "雪 Café"
Unicode Ω and café.
.RS 4
.B "bold 雪"
.RE
