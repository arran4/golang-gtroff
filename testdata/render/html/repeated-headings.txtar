test: repeated and nested selected headings retain unique anchors without duplicate content
-- options.json --
{"Section":"OPTIONS","Assets":"omit-fonts"}
-- input.1 --
.TH DEMO 1
.SH OPTIONS
first
.SS OPTIONS
nested
.SH OTHER
outside
.SH OPTIONS
second
