.TH "MAN-TOOL" "1" "2026-10-21" "Linux" "User Commands"
.SH "\f[B]NAME\f[R]"
.PP
\&\f[R]man-tool - inspect a source document\f[R]\c
.SH "\f[B]SYNOPSIS\f[R]"
.PP
\&\f[B]man-tool\f[R]\c
\&\f[R] [\f[R]\c
\&\f[B]-v\f[R]\c
\&\f[R]] [\f[R]\c
\&\f[B]-o\f[R]\c
\&\f[R] \f[R]\c
\&\f[I]file\f[R]\c
\&\f[R]] \f[R]\c
\&\f[I]input\f[R]\c
.SH "\f[B]DESCRIPTION\f[R]"
.PP
\&\f[R]Read \f[R]\c
\&\f[I]input\f[R]\c
\&\f[R] and inspect its structure.\f[R]\c
.PP
\&\f[R]Output preserves the original source independently of canonical text.\f[R]\c
.SS "\f[B]Input formats\f[R]"
.PP
\&\f[R]The first implementation handles typical Linux man pages.\f[R]\c
.SH "\f[B]OPTIONS\f[R]"
.PP
.TP "8"
\&\f[B]-v\f[R]

\&\f[R]Display verbose diagnostics on standard error.\f[R]\c
