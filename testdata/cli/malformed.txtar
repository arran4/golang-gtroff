{"schemaVersion":1,"command":"validate","sourceName":"<stdin>","assessment":"syntax-only","status":"invalid","diagnostics":[{"Message":"parse TokenManB arguments: \"broken, quote wasn't closed: stack \"","Position":{"Filename":"<stdin>","Offset":0,"Line":1,"Column":1},"Severity":"error"}]}
