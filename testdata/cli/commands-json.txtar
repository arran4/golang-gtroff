test: commands produces schemaVersion 1 json inventory
-- args.json --
["commands", "--format", "json"]
-- stdin.1 --
-- stdout.txt --
{
  "schemaVersion": 1,
  "command": "commands",
  "commands": [
    {
      "name": "validate",
      "synopsis": "gtroff validate [--strict] [--package man|ms|roff] [--format text|json] [FILE]",
      "description": "Check roff syntax and report diagnostics",
      "flags": [
        {
          "name": "strict",
          "type": "bool",
          "default": "false",
          "description": "Reject warnings, including unknown controls and unloaded includes"
        },
        {
          "name": "package",
          "type": "string",
          "default": "man",
          "description": "Package to use: man, ms or roff"
        },
        {
          "name": "format",
          "type": "string",
          "default": "text",
          "description": "Output format: text or json"
        }
      ],
      "capabilities": [
        "syntax-inspection",
        "diagnostics",
        "json-output",
        "text-output"
      ]
    },
    {
