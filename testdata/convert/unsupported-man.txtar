Unevaluated requests and definitions become escaped literal source, never active controls.
-- input.1 --
.TH UNKNOWN 1
.SH CONTENT
.so /etc/passwd
.unknown VISIBLE UNKNOWN
.de XX
DANGEROUS DEFINITION
..
Text \*[UNRESOLVED].
-- case.json --
{"equivalent":false,"retained":[".so /etc/passwd","VISIBLE UNKNOWN","DANGEROUS DEFINITION","\\*[UNRESOLVED]"]}
-- expected.1 --
.TH "UNKNOWN" "1" "" "" ""
.SH "\f[B]CONTENT\f[R]"
.nf
\&\f[CR].so /etc/passwd\f[R]\c

.fi
.nf
\&\f[CR].unknown VISIBLE UNKNOWN\f[R]\c

.fi
.nf
\&\f[CR].de XX\f[R]\c

\&\f[CR]DANGEROUS DEFINITION\f[R]\c

\&\f[CR]..\f[R]\c

.fi
.PP
\&\f[R]Text \e*[UNRESOLVED].\f[R]\c
