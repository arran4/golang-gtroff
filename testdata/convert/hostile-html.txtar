No script, image, stylesheet or HTML include is executed or fetched.
-- input.html --
<h1>Hostile</h1>
<script>fetch('file:///etc/passwd'); alert('SCRIPT CONTENT')</script>
<img src="file:///etc/passwd" onerror="alert('IMAGE CONTENT')">
<iframe src="https://example.com/remote">FRAME CONTENT</iframe>
<link rel="stylesheet" href="https://example.com/style.css">
<p onclick="run()"><a href="javascript:alert(1)">UNSAFE LABEL</a> <a href="file:///etc/passwd">FILE LABEL</a></p>
-- case.json --
{"equivalent":false,"retained":["SCRIPT CONTENT","IMAGE CONTENT","FRAME CONTENT","https://example.com/style.css","UNSAFE LABEL","FILE LABEL"]}
