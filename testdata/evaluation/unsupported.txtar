Unsafe and unsupported requests remain visible, with one diagnostic per token.
No includes or shell commands run. Undefined aliases report a diagnostic.
-- input.roff --
.so /etc/passwd
.sy echo unsafe
.als ALIAS SOURCE
.am GREET
appended
..
.de GREET
hello
..
.GREET argument
.UNKNOWN raw
-- expected.txt --
*groff.TokenRequestSo ".so /etc/passwd"
*groff.TokenRequestSy ".sy \"echo unsafe\""
*groff.TokenRequestAls ".als ALIAS SOURCE"
groff.TokenText "hello"
*groff.TokenUnknownControl ".UNKNOWN raw"
diagnostic token=0 path=[] token preserved without evaluation
diagnostic token=1 path=[] token preserved without evaluation
diagnostic token=2 path=[] alias target is undefined
diagnostic token=6 path=[] token preserved without evaluation
-- parsed.txt --
*groff.TokenRequestSo ".so /etc/passwd"
*groff.TokenRequestSy ".sy \"echo unsafe\""
*groff.TokenRequestAls ".als ALIAS SOURCE"
*groff.TokenMacroAppend ".am GREET\nappended\n.."
*groff.TokenMacroDefinition ".de GREET\nhello\n.."
*groff.TokenUnknownControl ".GREET argument"
*groff.TokenUnknownControl ".UNKNOWN raw"
