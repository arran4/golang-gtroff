Definitions, relative register updates, string append/redefinition and removal.
-- input.roff --
.nr X 10 2
.ds S old
\n[X] \*[S]
.nr X -3
.as S -tail
\nX \*S
.ds S new
.rr X
\n[X] \*[S]
-- expected.txt --
groff.TokenText "10 old"
groff.TokenText "7 old-tail"
groff.TokenText "0 new"
string S="new"
-- parsed.txt --
*groff.TokenRequestNr ".nr X 10 2"
*groff.TokenRequestDs ".ds S old"
groff.TokenText "\\n[X] \\*[S]"
*groff.TokenRequestNr ".nr X -3"
*groff.TokenRequestAs ".as S -tail"
groff.TokenText "\\nX \\*S"
*groff.TokenRequestDs ".ds S new"
*groff.TokenRequestRr ".rr X"
groff.TokenText "\\n[X] \\*[S]"
