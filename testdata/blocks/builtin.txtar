-- expected.txt --
document error=<nil>
token *groff.TokenTableBlock [0,28) raw=".TS H\n.B not dispatched\n.TE\n"
  closed=true header=".TS H\n" body=".B not dispatched\n" end=".TE\n"
token *groff.TokenEquationBlock [28,48) raw=".EQ C (1)\nx + y\n.EN\n"
