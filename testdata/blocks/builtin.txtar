token *groff.TokenPictureBlock [48,63) raw=".PS\ncircle\n.PF\n"
  closed=true header=".PS\n" body="circle\n" end=".PF\n"
token *groff.TokenReferenceBlock [63,77) raw=".[\n%T Book\n.]\n"
  closed=true header=".[\n" body="%T Book\n" end=".]\n"
ast error=<nil>
ast block .TS closed=true raw=".TS H\n.B not dispatched\n.TE\n"
ast block .EQ closed=true raw=".EQ C (1)\nx + y\n.EN\n"
ast block .PS closed=true raw=".PS\ncircle\n.PF\n"
ast block .[ closed=true raw=".[\n%T Book\n.]\n"
