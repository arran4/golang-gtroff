Quoted definition names/terminators and comments bind before body capture.
-- input.roff --
.de "X" "END" \" comment
.B raw
'END arguments
.am X STOP
extra
.STOP
.ig FIN
unknown
.FIN
-- options.json --
{"CRLF": true, "NoFinalLF": true}
-- expected.txt --
document error=<nil>
