token *groff.TokenMacroAppend [50,76) raw=".am X STOP\r\nextra\r\n.STOP\r\n"
  closed=true header=".am X STOP\r\n" body="extra\r\n" end=".STOP\r\n"
token *groff.TokenIgnoredBlock [76,98) raw=".ig FIN\r\nunknown\r\n.FIN"
  closed=true header=".ig FIN\r\n" body="unknown\r\n" end=".FIN"
ast error=<nil>
ast block .de closed=true raw=".de \"X\" \"END\" \\\" comment\r\n.B raw\r\n'END arguments\r\n"
