{"strict":true}
-- input.1 --
.TH TOOL 1 "2026-10-21" "Linux" "User Commands"
.SH NAME
tool \- inspect files
.SH SYNOPSIS
.SY tool
.OP \-v
.OP \-o file
.I input
.YS
