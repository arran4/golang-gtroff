test: malformed, unsafe and unevaluated constructs remain visible with diagnostics
-- options.json --
{"strict":true}
-- error.txt --
man semantics:
-- input.1 --
.SH NAME
.B "broken
.so /etc/passwd
.sy touch forbidden
.de CUSTOM
saved body
..
.CUSTOM
