# Scenario source and expected text must retain exact line-ending bytes.
testdata/ast/*.txtar -text
# CR bytes in this fixture are source data, not trailing whitespace errors.
testdata/ast/crlf.txtar whitespace=cr-at-eol

# CLI archives also contain byte-exact source scenarios.
testdata/cli/*.txtar -text
testdata/cli/crlf.txtar whitespace=cr-at-eol

# Semantic scenarios preserve original input independently of canonical JSON.
testdata/man/*.txtar -text

# HTML fixtures retain input bytes; font blobs are asserted via readable hashes.
testdata/render/html/*.txtar -text

# Conversion scenarios keep source and canonical bytes separate.
testdata/convert/*.txtar -text

# Textual image layouts stay readable; binary goldens live outside TXTAR.
testdata/image/*.txtar -text
testdata/golden/image/*.png binary
testdata/golden/image/*.jpg binary
examples/man-tool.png binary
examples/man-tool.jpg binary

# HTTP scenarios contain readable virtual trees, requests and response bodies.
testdata/serve/*.txtar -text
